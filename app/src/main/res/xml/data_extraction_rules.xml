<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is worth backing up: the app holds no account, no history, and no answer worth
  keeping. Declaring this explicitly stops the platform offering a backup in the first place,
  which would otherwise copy the model into the user's cloud backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="cache" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="cache" />
    </device-transfer>
</data-extraction-rules>