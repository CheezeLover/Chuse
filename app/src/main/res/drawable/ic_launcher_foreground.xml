<!--
  A faceted question mark: an angular hook and a diamond dot, rather than a smooth glyph.

  Straight segments and a hard geometric dot read as deliberate at launcher size, where a
  rounded question mark from a text font turns to mush. Drawn inside the 72dp adaptive-icon
  safe zone so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The hook, drawn as one faceted stroke. -->
    <path
        android:pathData="M34,44 L34,34 L44,24 L64,24 L74,34 L74,42 L54,58 L54,64"
        android:strokeColor="#7BE0C0"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- The dot, a diamond rather than a circle: the hard edge is the point. -->
    <path
        android:pathData="M54,74 L64,84 L54,94 L44,84 Z"
        android:fillColor="#7BE0C0" />
</vector>