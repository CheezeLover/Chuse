<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark variants of the framework theme, for the window background only. The palette
      itself is defined in Compose so dynamic colour can take over on devices that have it.
    -->
    <style name="Theme.Chuse" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>